  },
  {
    "label": "Build: app",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/Invoke-Build.ps1 -Operation Build -Target app"
  },
  {
    "label": "Test: shader",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/Invoke-Build.ps1 -Operation Test"
